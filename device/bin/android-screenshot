#!/data/data/com.termux/files/usr/bin/env bash
# Screen capture.
#
# An app uid cannot do this on its own: `screencap` lives in the shell/system
# domain and Termux:API exposes no MediaProjection bridge. There are two ways to
# get it, and this command uses whichever is available:
#
#   1. on-device adb   — `android-adb enable`, then screencap runs as shell uid
#   2. a host over USB — `aa ui screenshot` on the connected computer
#
# With neither, it fails loudly rather than pretending.
set -uo pipefail
. "$(dirname "$(readlink -f "$0")")/../lib/aa-common.sh"

case "${1:-}" in
  -h|--help) echo "usage: android-screenshot [OUTPUT.png]"; exit 0 ;;
esac

out="${1:-}"
if [ -z "$out" ]; then
  mkdir -p "$AA_ROOT/output"
  out="$AA_ROOT/output/screen-$(date '+%Y%m%d-%H%M%S').png"
fi
case "$out" in /*) ;; *) out="$PWD/$out" ;; esac
mkdir -p "$(dirname "$out")"

if aa_have adb && aa_adb_ready; then
  if aa_adb exec-out screencap -p > "$out" 2>/dev/null && [ -s "$out" ]; then
    aa_log screenshot "captured $out"
    printf '%s\n' "$out"
    exit 0
  fi
  rm -f "$out"
  aa_die "$AA_EXIT_RUNTIME" "screencap ran through adb but produced nothing"
fi

rm -f "$out" 2>/dev/null
aa_err "error: screen capture needs shell-level access, which this uid does not have."
aa_err "hint:  on the phone   — android-adb enable   (read its warning first)"
aa_err "hint:  from a computer — aa ui screenshot"
exit "$AA_EXIT_UNAVAILABLE"
